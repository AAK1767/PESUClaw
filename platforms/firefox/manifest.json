{
  "manifest_version": 3,
  "name": "PESUClaw",
  "version": "1.2.0",
  "description": "Download slides, notes, assignments, QA, and QB from PESU Academy — merge PDFs, zip files, one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "https://www.pesuacademy.com/*",
    "https://files.pesuacademy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pesuacademy.com/Academy/*"
      ],
      "js": [
        "loader.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "lib/*",
    "content.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pesuclaw@pesuacademy",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "personal_data_collected": false,
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
